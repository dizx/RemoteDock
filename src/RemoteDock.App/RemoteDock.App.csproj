<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyTitle>RemoteDock</AssemblyTitle>
    <Product>RemoteDock</Product>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\RemoteDock.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
    <Resource Include="Assets\RemoteDock.ico" />
    <ProjectReference Include="..\RemoteDock.Core\RemoteDock.Core.csproj" />
    <Reference Include="MSTSCLib">
      <HintPath>..\..\artifacts\interop\MSTSCLib.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="AxMSTSCLib">
      <HintPath>..\..\artifacts\interop\AxMSTSCLib.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="RequireRdpInterop" BeforeTargets="ResolveAssemblyReferences"
          Condition="!Exists('$(MSBuildProjectDirectory)\..\..\artifacts\interop\AxMSTSCLib.dll')">
    <Error Text="Generate the Windows RDP wrappers first: powershell -ExecutionPolicy Bypass -File scripts/Generate-RdpInterop.ps1" />
  </Target>
</Project>
