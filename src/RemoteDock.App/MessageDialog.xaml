<Window x:Class="RemoteDock.App.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Width="480" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24">
    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <Border x:Name="Accent" Background="#83CEDA" CornerRadius="2" />
      <TextBlock x:Name="Heading" Grid.Column="1" Margin="12,0,0,0" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
    </Grid>
    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <TextBlock x:Name="MessageText" Foreground="#BFCDDB" TextWrapping="Wrap" Margin="0,0,8,0" />
    </ScrollViewer>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="ConfirmButton" Content="Yes" MinWidth="80" Visibility="Collapsed" Click="Confirm_Click" />
      <Button x:Name="DismissButton" Content="Close" MinWidth="80" IsCancel="True" Click="Dismiss_Click" />
    </StackPanel>
  </StackPanel>
</Window>
