<Window x:Class="RemoteDock.App.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="About RemoteDock" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="28">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
      <Image Source="{StaticResource RemoteDockMark}" Width="56" Height="56" Margin="0,0,16,0" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="RemoteDock" FontSize="26" FontWeight="SemiBold" />
        <TextBlock x:Name="VersionText" Foreground="#A9BBCD" Margin="0,4,0,0" />
      </StackPanel>
    </StackPanel>
    <TextBlock Text="Room for the remote." FontSize="16" Margin="0,0,0,8" />
    <TextBlock Text="A remote desktop connection manager for Windows."
               TextWrapping="Wrap" Foreground="#A9BBCD" Margin="0,0,0,16" />
    <TextBlock x:Name="CopyrightText" Margin="0,0,0,20" />
    <TextBlock Margin="0,0,0,8">
      <Hyperlink NavigateUri="https://github.com/dizx/RemoteDock" RequestNavigate="Link_RequestNavigate" Foreground="#83CEDA">GitHub repository</Hyperlink>
    </TextBlock>
    <TextBlock Margin="0,0,0,20">
      <Hyperlink NavigateUri="https://github.com/dizx/RemoteDock/issues" RequestNavigate="Link_RequestNavigate" Foreground="#83CEDA">Report an issue</Hyperlink>
    </TextBlock>
    <Button Content="Close" IsDefault="True" IsCancel="True" Click="Close_Click" HorizontalAlignment="Right" MinWidth="84" />
  </StackPanel>
</Window>
