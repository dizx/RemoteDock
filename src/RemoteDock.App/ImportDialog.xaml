<Window x:Class="RemoteDock.App.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="Import connections"
        Width="620" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24">
    <TextBlock Text="Bring your connections" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,14" />
    <TextBlock Text="Import RemoteDock connections.json, mRemoteNG XML or .rdp files. Existing imported entries are updated; other connections are kept."
               TextWrapping="Wrap" Foreground="#A9BBCD" Margin="0,0,0,12" />
    <TextBox x:Name="PathsBox" IsReadOnly="True" Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Import files" />
    <Button Content="Choose files…" Click="Browse_Click" HorizontalAlignment="Left" />
    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#68E2E8" Margin="0,12" />
    <TextBlock Text="RemoteDock files keep their connection and display settings. Usernames, domains, passwords, history and personal app preferences are ignored."
               TextWrapping="Wrap" Foreground="#A9BBCD" Margin="0,0,0,12" />
    <CheckBox x:Name="PasswordsBox" IsChecked="True" Content="Import saved passwords from mRemoteNG / .rdp files" />
    <CheckBox x:Name="ScaledFitBox" IsChecked="True" Content="Use shared Scaled Fit (1/2 resolution) for mRemoteNG / .rdp files" />
    <TextBlock Text="mRemoteNG master password (only if you set a custom one)" Margin="0,12,0,0" />
    <PasswordBox x:Name="MasterPassword" AutomationProperties.Name="mRemoteNG master password" />
    <TextBlock x:Name="ErrorText" Foreground="#FFAFA8" TextWrapping="Wrap" Margin="0,4,0,12" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="ImportButton" Content="Import connections" IsDefault="True" Click="Import_Click" />
      <Button Content="Cancel" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
