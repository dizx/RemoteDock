<Window x:Class="RemoteDock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="RemoteDock" Width="1280" Height="820" MinWidth="780" MinHeight="480"
        PreviewKeyDown="Window_KeyDown" Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border x:Name="Toolbar" Background="#0B1018" BorderBrush="#253343" BorderThickness="0,0,0,1" Padding="16,9">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Content="Reconnect" Click="Reconnect_Click" ToolTip="Reconnect the active session" />
          <Button x:Name="FocusButton" Content="Focus Mode" Click="Focus_Click" ToolTip="Hide navigation and tabs · Ctrl+Shift+F when local UI has focus" />
          <Button x:Name="FullscreenButton" Content="Full screen" Click="Fullscreen_Click" ToolTip="F11 when local UI has focus" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Image Source="{StaticResource RemoteDockMark}" Width="38" Height="38" Margin="0,0,11,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="RemoteDock" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Your connections. More room to work." Foreground="#A9BBCD" FontSize="11" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border x:Name="FocusStrip" Grid.Row="1" Background="{StaticResource Surface}" Visibility="Collapsed">
      <DockPanel Margin="8,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Previous" Click="Previous_Click" Padding="8,2" />
          <Button Content="Next" Click="Next_Click" Padding="8,2" />
          <Button x:Name="ExitFocusButton" Content="Exit Focus" Click="Focus_Click" Padding="8,2" />
          <Button Content="Full screen / restore" Click="Fullscreen_Click" Padding="8,2" />
        </StackPanel>
        <TextBlock x:Name="FocusTitle" VerticalAlignment="Center" Text="RemoteDock" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border x:Name="Sidebar" Background="{StaticResource Surface}" BorderBrush="#304055" BorderThickness="0,1,1,0">
        <DockPanel Margin="14">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="CONNECTIONS" FontWeight="SemiBold" Foreground="#A9BBCD" Margin="0,8,0,12" />
            <TextBlock Text="Search connections" Foreground="#A9BBCD" FontSize="11" />
            <TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Search by connection name or host" AutomationProperties.Name="Search connections" />
            <Button Content="+ New connection" Click="New_Click" Margin="0,0,0,12" HorizontalContentAlignment="Left" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button Content="Connect" Click="Connect_Click" Margin="0,3" />
            <StackPanel Orientation="Horizontal">
              <Button Content="Edit" Click="Edit_Click" />
              <Button Content="Delete" Click="Delete_Click" />
            </StackPanel>
          </StackPanel>
          <ListBox x:Name="ConnectionsList" Background="Transparent" Foreground="White" BorderThickness="0"
                   MouseDoubleClick="Connection_DoubleClick" KeyDown="Connection_KeyDown"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Saved connections">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4,8">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Host}" FontSize="11" Foreground="#91A5BB" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <ListBox x:Name="Tabs" Background="#101722" Foreground="White" BorderThickness="0" MinHeight="40"
                 SelectionChanged="Tab_Changed" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Session tabs">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
        </ListBox>
        <Grid x:Name="SessionSurface" Grid.Row="1" Background="#0B1018" ClipToBounds="True">
          <StackPanel x:Name="Welcome" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="32">
            <TextBlock Text="Room for the remote." FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="Connect to a Windows desktop or Hyper-V console. Fit your workspace with fewer remote pixels and more room to work."
                       TextWrapping="Wrap" Foreground="#A9BBCD" FontSize="16" Margin="0,16,0,24" />
            <Button Content="Add your first connection" Click="New_Click" HorizontalAlignment="Left" />
            <TextBlock Text="Scaled Fit · 1/2 resolution · adapts as you resize" Foreground="#7CC9D4" Margin="3,18,0,0" />
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
    <Border x:Name="StatusBar" Grid.Row="3" Background="{StaticResource Surface}" Padding="16,7">
      <TextBlock x:Name="StatusText" Text="Ready" Foreground="#A9BBCD" TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</Window>
