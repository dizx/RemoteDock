<Window x:Class="RemoteDock.App.CredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Connect" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24">
    <TextBlock x:Name="Heading" FontSize="22" TextWrapping="Wrap" Margin="0,0,0,16" />
    <TextBlock Text="User name" />
    <TextBox x:Name="UserBox" />
    <TextBlock Text="Domain (optional)" />
    <TextBox x:Name="DomainBox" />
    <TextBlock Text="Password" />
    <PasswordBox x:Name="PasswordInput" />
    <TextBlock Text="Password is used for this connection only. Leave credentials blank to let Windows handle authentication."
               TextWrapping="Wrap" Foreground="#A9BBCD" Margin="0,0,0,16" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" />
      <Button Content="Connect" IsDefault="True" Click="Connect_Click" />
    </StackPanel>
  </StackPanel>
</Window>
